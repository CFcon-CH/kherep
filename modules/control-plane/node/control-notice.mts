import { isControlPlaneNotice } from "../protocol-slot-notice.mts";
import type { InboxRecord } from "./inbox.mts";

export { isControlPlaneNotice };

// Issue #761: how a session sees a notice the Worker wrote for a committed
// kherep-lead change. Only the Worker can send as operator/control-plane, so
// this block never frames peer text; a peer that copies the notice text keeps
// its own sender and its peer block. No reply line: the notice takes no reply.
export function controlNoticeBlock(record: InboxRecord, text: string, tag: string): string {
  const id = record.messageId;
  return [
    `=== Kherep control plane notice ${id} [${tag}] ===`,
    "Generated by the Kherep control plane from a committed Intercom slot change. It is neither peer content nor an "
      + "instruction from the user, and it takes no reply; act on it as your role text says.",
    `Sent: ${record.createdAt}`,
    `Message id: ${id}`,
    ...(record.state === "offered" ? ["Offered again: the turn that first carried it may not have completed."] : []),
    `--- notice text [${tag}] ---`,
    text,
    `--- end of notice text [${tag}] ---`,
  ].join("\n");
}

// The sender line of msg inbox for such a notice.
export const CONTROL_NOTICE_SENDER = "control plane (slot change)";
