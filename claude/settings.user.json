{
  "env": {},
  "permissions": {
    "allow": [
      "Bash(node __KHEREP_WORKSPACE__/tools/atl-confluence-ccoder.mts get:*)",
      "Bash(node __KHEREP_WORKSPACE__/tools/atl-confluence-ccoder.mts related:*)",
      "Bash(node __KHEREP_WORKSPACE__/tools/atl-confluence-ccoder.mts search:*)",
      "Bash(node __KHEREP_WORKSPACE__/tools/atl-confluence-ccoder.mts create:*)",
      "Bash(node __KHEREP_WORKSPACE__/tools/atl-confluence-ccoder.mts labels:*)",
      "Bash(node __KHEREP_WORKSPACE__/tools/atl-confluence-ccoder.mts stitch:*)",
      "Bash(node __KHEREP_WORKSPACE__/tools/atl-confluence-ccoder.mts children:*)",
      "Read(//__KHEREP_CLAUDE_HOME__/kherep/confluence.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" pretool \"__KHEREP_CLAUDE_HOME__/hooks/guard-dispatch.mts\" \"__KHEREP_CLAUDE_HOME__/hooks/privacy-boundary-guard.mts\" \"__KHEREP_CLAUDE_HOME__/hooks/secret-output-guard.mts\" \"__KHEREP_CLAUDE_HOME__/hooks/playwright-file-guard.mts\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" pretool \"__KHEREP_CLAUDE_HOME__/hooks/guard-dispatch.mts\" \"__KHEREP_CLAUDE_HOME__/hooks/dispatch-contract-guard.mts\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" pretool \"__KHEREP_CLAUDE_HOME__/hooks/guard-dispatch.mts\" \"__KHEREP_CLAUDE_HOME__/hooks/commit-guard.mts\" \"__KHEREP_CLAUDE_HOME__/hooks/deploy-guard.mts\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" pretool \"__KHEREP_CLAUDE_HOME__/hooks/guard-dispatch.mts\" \"__KHEREP_CLAUDE_HOME__/hooks/main-checkout-guard.mts\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*__executeDestructive",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" pretool \"__KHEREP_CLAUDE_HOME__/hooks/guard-dispatch.mts\" \"__KHEREP_CLAUDE_HOME__/hooks/atlassian-destructive-guard.mts\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" pretool \"__KHEREP_CLAUDE_HOME__/hooks/guard-dispatch.mts\" \"__KHEREP_CLAUDE_HOME__/hooks/obs-handback-gate.mts\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/manifest-watch.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/loc-watch.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/umlaut-translit-watch.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/simplify-nudge.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/drift-managed-path-watch.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/control-plane/claude-control-plane-hook.mts\" deliver"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/control-plane/claude-control-plane-hook.mts\" attribution"
          }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/obs-handback-record.mts\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/denied-calls-delivered.mts\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" writer \"__KHEREP_CLAUDE_HOME__/hooks/live-hook-integrity.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/orchestra-default.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/runtime-capability-snapshot.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/drift-check-nudge.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/smoke-test-nudge.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/orphan-check-nudge.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/critical-file-integrity.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/control-plane/claude-control-plane-hook.mts\" wake --timeout 86400",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/maestro-discipline.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/research-first.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/control-plane/claude-control-plane-hook.mts\" deliver"
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/control-plane/claude-control-plane-hook.mts\" wake --timeout 86400",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/maestro-banner-gate.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/clq-accept-gate.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/observation-stop.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/research-stop.mts\""
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/control-plane/claude-control-plane-hook.mts\" deliver"
          },
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/control-plane/claude-control-plane-hook.mts\" wake --timeout 86400",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/control-plane/claude-control-plane-hook.mts\" deliver"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "claude-obs",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__KHEREP_CLAUDE_HOME__/kherep/hook-runtime/entry.mts\" reader \"__KHEREP_CLAUDE_HOME__/hooks/obs-result-check.mts\""
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  }
}
