{
  "name": "kherep",
  "version": "0.5.0",
  "private": true,
  "description": "Kherep orchestration stack. TypeScript runs directly on Node (type stripping, no build); tsc is the type check only.",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test:bootstrap": "node --test \"bootstrap/*.test.mts\"",
    "test:codex": "node --test \"codex/*.test.mts\" \"codex/lib/*.test.mts\" \"codex/hooks/*.test.mts\" \"codex/scripts/*.test.mts\"",
    "test:brokers": "node --test \"modules/atl-jira-brokers/*.test.mts\" \"modules/github-broker/*.test.mts\"",
    "test:modules": "node --test \"lib/*.test.mts\" \"modules/local-inference/*.test.mts\" \"modules/mcp-auth-bridge/*.test.mts\"",
    "test:control-plane": "node --test \"modules/control-plane/*.test.mts\" \"modules/control-plane/node/*.test.mts\"",
    "test:route": "node bootstrap/test-route.mts",
    "audit:publication": "node bootstrap/publication-audit.mts",
    "coverage:report": "node bootstrap/coverage-report.mts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "c8": "12.0.0",
    "typescript": "6.0.3"
  },
  "license": "Apache-2.0",
  "overrides": {
    "test-exclude": {
      "glob": "14.0.3",
      "minimatch": "11.0.4"
    }
  }
}
